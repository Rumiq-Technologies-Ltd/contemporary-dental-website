# Public https address of the website: canonical links, Open Graph tags, the sitemap, robots.txt and structured data.
# Required in the Vercel Production environment (production builds fail without it). Redeploy after changing it.
# Local builds fall back to http://127.0.0.1:3000 when it is unset.
NEXT_PUBLIC_SITE_URL=https://www.contemporarydentalcare.com

# Enquiry form email (Resend). Used only when the form is switched on (appointmentFormEnabled in
# src/content/site.ts), and only after the Resend BAA is confirmed in writing. Never commit the key.
# The from address must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
