{
  "name": "contemporary-dental-care",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack && node scripts/build-csp.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
